{
	"name": "@moritzloewenstein/vite-plugin-zip",
	"version": "2.0.0",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MoritzLoewenstein/vite-plugin-zip.git"
	},
	"description": "",
	"files": [
		"dist"
	],
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": "./dist/index.mjs",
		"./package.json": "./package.json"
	},
	"publishConfig": {
