		"biome:ci": "biome ci .",
		"test": "node --test",
		"test:only": "node --test --test-only",
		"test:watch": "node --test --watch"
	},
	"keywords": [
		"vite-plugin"
	],
	"author": {
		"name": "Moritz Löwenstein",
