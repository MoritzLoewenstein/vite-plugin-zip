	},
	"volta": {
		"node": "22.20.0"
	},
	"peerDependencies": {
		"vite": "^8.0.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.10",
		"@types/adm-zip": "^0.5.8",
		"@types/archiver": "^7.0.0",
		"adm-zip": "^0.5.17",
		"tsdown": "^0.21.7",
